---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = (await getCollection('proyectos')).sort((a, b) => a.data.order - b.data.order);
  return projects.map((project, index) => ({
    params: { id: project.id },
    props: {
      project,
      nextProject: projects[(index + 1) % projects.length]
    }
  }));
}

const { project, nextProject } = Astro.props;
const { Content } = await render(project);
const referenceVisuals: Record<string, { src: string; alt: string; caption: string }> = {
  'provocaciones-escenicas': {
    src: '/images/reference/teatro-el-circulo-rosario.webp',
    alt: 'Fachada del Teatro El Círculo de Rosario',
    caption: 'Referencia visual del campo escénico rosarino. No corresponde al programa Provocaciones Escénicas.'
  },
  'argentina-florece': {
    src: '/images/reference/murga-aquelarre-santa-fe-2017.webp',
    alt: 'Integrante de una murga de mujeres de Santa Fe durante una actividad escénica',
    caption: 'Referencia visual de producción escénica en Santa Fe. No corresponde al programa Argentina Florece.'
  },
  'subversion-feminista': {
    src: '/images/reference/enm-rosario-2016.webp',
    alt: 'Encuentro Nacional de Mujeres realizado en Rosario en 2016',
    caption: 'Referencia visual del entramado feminista rosarino. No corresponde al Festival SubVersión Feminista.'
  },
  'la-comedia-de-hacer-arte': {
    src: '/images/reference/performance-flora-tristan-2025.webp',
    alt: 'Performance feminista realizada por el Centro de la Mujer Peruana Flora Tristán',
    caption: 'Referencia visual de escena y acción cultural feminista. No corresponde a La Comedia de Hacer Arte.'
  }
};
const referenceVisual = referenceVisuals[project.id];
---
<BaseLayout title={`${project.data.title} — Dannae Abdalla`} description={project.data.summary}>
  <article class="project-detail" data-accent={project.data.accent}>
    <header class="container detail-hero">
      <div class="detail-hero-top mono">
        <a href="/proyectos/">← Archivo de proyectos</a>
        <span>{project.data.period}</span>
      </div>

      <p class="page-kicker">{project.data.eyebrow}</p>
      <h1 class="detail-title">{project.data.title}</h1>

      <div class="detail-intro-grid">
        <p class="detail-summary">{project.data.summary}</p>
        <div class="detail-roles">
          <span class="meta-label mono">Rol</span>
          <ul>{project.data.role.map((item) => <li>{item}</li>)}</ul>
        </div>
      </div>
    </header>

    {project.data.metrics.length > 0 && (
      <section class="container project-metric-strip" aria-label="Datos del proyecto">
        {project.data.metrics.map((item, index) => (
          <div class="project-metric-card">
            <span class="mono">0{index + 1}</span>
            <strong>{item}</strong>
          </div>
        ))}
      </section>
    )}

    <section class="container detail-body-grid">
      <aside class="detail-rail">
        <span class="meta-label mono">Proyecto</span>
        <p>{project.data.period}</p>
        <p class="detail-rail-note">Gestión cultural · producción · articulación · evaluación</p>
      </aside>

      <div class="prose prose-project"><Content /></div>

      {referenceVisual && (
        <figure class="detail-reference-visual">
          <img src={referenceVisual.src} alt={referenceVisual.alt} loading="lazy" />
          <figcaption>
            {referenceVisual.caption} <a href="/creditos/">Créditos →</a>
          </figcaption>
        </figure>
      )}
    </section>

    <nav class="container archive-next" aria-label="Siguiente proyecto">
      <span class="mono">Siguiente proyecto</span>
      <a href={`/proyectos/${nextProject.id}/`}>
        <strong>{nextProject.data.title}</strong>
        <b>→</b>
      </a>
    </nav>
  </article>
</BaseLayout>
