---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectRow from '../components/ProjectRow.astro';
import { getCollection } from 'astro:content';
const projects = (await getCollection('proyectos')).sort((a, b) => a.data.order - b.data.order);
const texts = (await getCollection('textos')).sort((a, b) => a.data.order - b.data.order);
const featuredText = texts.find((text) => text.data.featured) ?? texts[0];
const secondaryTexts = texts.filter((text) => text.id !== featuredText?.id).slice(0, 6);
---
<BaseLayout bodyClass="home-page">
  <section class="hero container">
    <div class="hero-index mono">00 / ROSARIO</div>
    <div class="hero-main">
      <p class="eyebrow">Gestora cultural · Actriz · Investigadora</p>
      <h1>Hacer que las cosas sucedan.</h1>
      <p class="lead">Gestión, investigación y producción cultural en la intersección entre artes escénicas, políticas culturales y feminismos.</p>
      <div class="hero-actions">
        <a class="text-link accent-link accent-blue" href="#proyectos">Proyectos ↓</a>
        <a class="text-link accent-link accent-magenta" href="#textos">Textos ↓</a>
      </div>
    </div>
    <div class="hero-board" aria-label="Composición gráfica conceptual">
      <div class="hero-board-copy">
        <span>gestión</span>
        <span>escena</span>
        <span>pensamiento</span>
      </div>
      <figure class="hero-board-photo">
        <img src="/images/reference/enm-rosario-2016.webp" alt="Encuentro Nacional de Mujeres en Rosario, 2016" />
      </figure>
      <div class="hero-board-note mono">cultura / territorio / vínculos</div>
    </div>
  </section>
  <section id="proyectos" class="container section-grid ruled">
    <div class="section-number">01</div>
    <div class="section-title">
      <p class="eyebrow">Proyectos seleccionados</p>
      <h2>Gestión puesta en práctica.</h2>
    </div>
    <div class="projects-list">
      {projects.map((project, index) => (
        <ProjectRow
          index={index + 1}
          id={project.id}
          title={project.data.title}
          eyebrow={project.data.eyebrow}
          period={project.data.period}
          metrics={project.data.metrics}
          accent={project.data.accent}
        />
      ))}
      <a class="archive-inline-link accent-link accent-blue" href="/proyectos/">Ver archivo de proyectos →</a>
    </div>
  </section>
  <section id="bio" class="container section-grid ruled statement-section">
    <div class="section-number">02</div>
    <div class="statement">
      <p class="eyebrow">Una forma de hacer</p>
      <p class="statement-large">Gestionar es construir vínculos, producir condiciones y disputar sentidos.</p>
    </div>
    <div class="statement-side">
      <p>Una práctica situada entre la gestión cultural, las artes escénicas, la investigación y los feminismos.</p>
      <p class="mono statement-note">hacer / pensar / producir / evaluar / volver a hacer</p>
      <a class="text-link accent-link accent-teal" href="/textos/hacer-que-las-cosas-sucedan/">Leer una forma de hacer →</a>
      <a class="text-link accent-link accent-yellow" href="/bio/">Bio y trayectoria →</a>
    </div>
  </section>
  <section id="textos" class="editorial-band">
    <div class="container section-grid editorial-grid">
      <div class="section-number">03</div>
      <div class="editorial-heading">
        <p class="eyebrow">Textos e investigación</p>
        <h2>Pensar también es una forma de hacer.</h2>
      </div>
      {featuredText && (
        <a class="featured-text" href={`/textos/${featuredText.id}/`}>
          <span class="featured-text-meta mono">{featuredText.data.type} · {featuredText.data.year}</span>
          <strong>{featuredText.data.title}</strong>
          <p>{featuredText.data.summary}</p>
          <span class="featured-text-arrow">Leer →</span>
        </a>
      )}
      <div class="texts-list editorial-list">
        {secondaryTexts.map((text) => (
          <a href={`/textos/${text.id}/`} class="text-row">
            <span>{text.data.year}</span>
            <strong>{text.data.title}</strong>
            <em>{text.data.type}</em>
            <b>→</b>
          </a>
        ))}
        <a class="archive-inline-link archive-inline-link-dark" href="/textos/">Ver archivo de textos →</a>
      </div>
    </div>
  </section>
  <section class="container section-grid ruled metrics-section">
    <div class="section-number">04</div>
    <div class="section-title">
      <p class="eyebrow">Datos del hacer</p>
      <h2>Escala, seguimiento y articulación.</h2>
    </div>
    <div class="metrics-grid">
      <div class="metric metric-yellow"><strong>300+</strong><span>funciones programadas<br />Argentina Florece</span></div>
      <div class="metric metric-teal"><strong>600+</strong><span>espectadores<br />Provocaciones Escénicas</span></div>
      <div class="metric metric-coral"><strong>180</strong><span>cuestionarios<br />de monitoreo</span></div>
      <div class="metric metric-blue"><strong>30</strong><span>organizaciones articuladas<br />en Bacanal</span></div>
    </div>
  </section>
  <section class="container scene-editorial ruled">
    <div class="scene-index mono">05 / ESCENA</div>
    <div class="scene-title-wrap">
      <p class="eyebrow">Actuación · Producción · Gestión</p>
      <h2>El teatro no aparece al costado de la gestión.</h2>
    </div>
    <figure class="scene-photo">
      <img src="/images/reference/performance-flora-tristan-2025.webp" alt="Performance sobre el sufragio femenino organizada por el Centro de la Mujer Peruana Flora Tristán" loading="lazy" />
      <figcaption><a href="/creditos/">Imagen de referencia · créditos →</a></figcaption>
    </figure>
    <div class="scene-copy">
      <p>Más de veinte años de teatro conectan actuación, producción y gestión dentro de una misma práctica.</p>
      <a class="text-link accent-link accent-magenta" href="/escena/">Leer recorrido escénico →</a>
    </div>
  </section>
  <section id="trayectoria" class="container section-grid ruled trajectory-preview">
    <div class="section-number">06</div>
    <div class="section-title">
      <p class="eyebrow">Trayectoria</p>
      <h2>De la escena a la gestión. Del hacer a la investigación.</h2>
      <a class="text-link accent-link accent-yellow trajectory-link" href="/bio/">Bio completa →</a>
    </div>
    <div class="trajectory-crossings">
      <div><span class="mono">2006—2009</span><strong>Escena</strong><p>Formación actoral.</p></div>
      <div><span class="mono">2020—2026</span><strong>Gestión</strong><p>Licenciatura en Gestión Cultural · UNR.</p></div>
      <div><span class="mono">2022—2024</span><strong>Territorio</strong><p>Instituto Nacional de Teatro · 300+ funciones.</p></div>
      <div><span class="mono">2018—2026</span><strong>Escritura</strong><p>Publicaciones, investigación y tesina.</p></div>
    </div>
  </section>
  <section id="contacto" class="contact-wrap">
    <div class="container section-grid contact-section">
      <div class="section-number">07</div>
      <div>
        <p class="eyebrow">Contacto</p>
        <h2>Rosario, Argentina.</h2>
      </div>
      <div class="contact-links">
        <a href="mailto:dannaeabdalla@gmail.com">dannaeabdalla@gmail.com</a>
        <a href="https://www.instagram.com/alegremonton/" rel="me">Instagram ↗</a>
        <a href="https://www.linkedin.com/in/dannae-abdalla-4208721b0/" rel="me">LinkedIn ↗</a>
      </div>
    </div>
  </section>
</BaseLayout>
