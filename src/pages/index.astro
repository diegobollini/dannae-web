---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectRow from '../components/ProjectRow.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('proyectos')).sort((a, b) => a.data.order - b.data.order);
const texts = (await getCollection('textos')).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout>
  <section class="hero container section-grid">
    <div class="section-number">00</div>
    <div class="hero-copy">
      <p class="eyebrow">Gestora cultural · Actriz · Investigadora</p>
      <h1>Hacer que las cosas sucedan.</h1>
      <p class="lead">Gestión, investigación y producción cultural en la intersección entre artes escénicas, políticas culturales y feminismos.</p>
      <div class="hero-actions">
        <a class="text-link" href="#proyectos">Ver proyectos →</a>
        <a class="text-link" href="#textos">Leer textos →</a>
      </div>
    </div>
    <div class="hero-composition" aria-label="Composición gráfica conceptual">
      <div class="color-panel blue"><strong>gestión<br />+ territorio</strong></div>
      <div class="color-panel magenta"><strong>escena</strong></div>
      <div class="color-panel yellow"><strong>pensar<br />el hacer</strong></div>
    </div>
  </section>

  <section id="proyectos" class="container section-grid ruled">
    <div class="section-number">01</div>
    <div class="section-title">
      <p class="eyebrow">Proyectos seleccionados</p>
      <h2>Gestión puesta en práctica.</h2>
    </div>
    <div class="projects-list">
      {projects.map((project, index) => (
        <ProjectRow
          index={index + 1}
          id={project.id}
          title={project.data.title}
          eyebrow={project.data.eyebrow}
          period={project.data.period}
          metrics={project.data.metrics}
          accent={project.data.accent}
        />
      ))}
    </div>
  </section>

  <section id="bio" class="container section-grid ruled">
    <div class="section-number">02</div>
    <div class="statement">
      <p class="eyebrow">Una forma de hacer</p>
      <p class="statement-large">Gestionar es construir vínculos, producir condiciones y disputar sentidos.</p>
    </div>
    <div class="statement-side">
      <p>Una práctica situada entre la gestión cultural, las artes escénicas, la investigación y los feminismos.</p>
      <a class="text-link" href="#trayectoria">Recorrer trayectoria →</a>
    </div>
  </section>

  <section class="container section-grid ruled">
    <div class="section-number">03</div>
    <div class="section-title">
      <p class="eyebrow">Datos del hacer</p>
      <h2>Escala y articulación.</h2>
    </div>
    <div class="metrics-grid">
      <div class="metric"><strong>300+</strong><span>funciones programadas<br />Argentina Florece</span></div>
      <div class="metric"><strong>600+</strong><span>espectadores<br />Provocaciones Escénicas</span></div>
      <div class="metric"><strong>180</strong><span>cuestionarios<br />de monitoreo</span></div>
      <div class="metric"><strong>30</strong><span>organizaciones articuladas<br />en Bacanal</span></div>
    </div>
  </section>

  <section id="textos" class="container section-grid ruled">
    <div class="section-number">04</div>
    <div class="section-title">
      <p class="eyebrow">Textos e investigación</p>
      <h2>Pensar también es una forma de hacer.</h2>
    </div>
    <div class="texts-list">
      {texts.map((text) => (
        <a href={`/textos/${text.id}/`} class="text-row">
          <span>{text.data.year}</span>
          <strong>{text.data.title}</strong>
          <em>{text.data.type}</em>
          <b>→</b>
        </a>
      ))}
    </div>
  </section>

  <section class="container section-grid ruled">
    <div class="section-number">05</div>
    <div class="section-title">
      <p class="eyebrow">Escena</p>
      <h2>El teatro no aparece al costado de la gestión.</h2>
    </div>
    <div class="scene-copy">
      <p>Actuación, producción y gestión conviven dentro de una misma práctica.</p>
      <p class="mono">Fotografía pendiente de selección antes del lanzamiento público.</p>
    </div>
    <div class="scene-card" aria-label="Marcador gráfico para futura fotografía escénica">
      <span class="eyebrow">imagen futura</span>
      <strong class="stage-word">ESCENA</strong>
    </div>
  </section>

  <section id="trayectoria" class="container section-grid ruled">
    <div class="section-number">06</div>
    <div class="section-title">
      <p class="eyebrow">Trayectoria</p>
      <h2>Instituciones, programas y redes.</h2>
    </div>
    <div class="timeline">
      <div><span>Actualidad</span><strong>Laboratorio de Innovación en Política y Gestión Cultural · UNR</strong></div>
      <div><span>2022—2024</span><strong>Instituto Nacional de Teatro</strong></div>
      <div><span>—</span><strong>La Comedia de Hacer Arte</strong></div>
      <div><span>—</span><strong>Orquesta Sinfónica de Rosario · Ministerio de Cultura de Santa Fe</strong></div>
    </div>
  </section>

  <section id="contacto" class="container section-grid ruled contact-section">
    <div class="section-number">07</div>
    <div>
      <p class="eyebrow">Contacto</p>
      <h2>Rosario, Argentina.</h2>
    </div>
    <div class="contact-links">
      <a href="mailto:dannaeabdalla@gmail.com">dannaeabdalla@gmail.com</a>
      <a href="https://www.instagram.com/alegremonton/" rel="me">Instagram ↗</a>
      <a href="https://www.linkedin.com/in/dannae-abdalla-4208721b0/">LinkedIn ↗</a>
    </div>
  </section>
</BaseLayout>
