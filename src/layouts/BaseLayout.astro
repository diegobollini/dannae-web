---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Dannae Abdalla',
  description = 'Gestión cultural, artes escénicas, investigación y feminismos.'
} = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f0e9dc" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <header class="site-header container">
      <a class="brand" href="/">DANNAE ABDALLA</a>
      <nav class="site-nav" aria-label="Principal">
        <a href="/#proyectos">Proyectos</a>
        <a href="/#textos">Textos</a>
        <a href="/#trayectoria">Trayectoria</a>
        <a href="/#bio">Bio</a>
        <a href="/#contacto">Contacto</a>
      </nav>
    </header>
    <main id="contenido"><slot /></main>
    <footer class="site-footer container">
      <span>Dannae Abdalla · Rosario</span>
      <span><a href="/creditos/">Créditos visuales</a> · <a href="https://github.com/diegobollini/dannae-web">Código fuente ↗</a></span>
    </footer>
  </body>
</html>
